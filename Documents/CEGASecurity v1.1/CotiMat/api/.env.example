# Puerto donde escucha la API
PORT=4000
NODE_ENV=development

# Cadena de conexión a PostgreSQL (único proceso con acceso a la BD)
DATABASE_URL="postgresql://cotimat:cotimat@localhost:5432/cotimat?schema=public"

# JWT para sesión de administradores
JWT_SECRET="change-this-in-production-please"
JWT_EXPIRES_IN="8h"

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Carpeta local donde se guardan imágenes de materiales (StorageService local)
UPLOADS_DIR="uploads"

# Credenciales del admin sembrado por el seed (solo entorno de desarrollo)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="admin123"
