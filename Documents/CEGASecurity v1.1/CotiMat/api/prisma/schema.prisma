generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
}

enum MaterialUnit {
  PIEZA
  M2
  M3
  KG
  SACO
  LITRO
  TONELADA
}

enum QuoteStatus {
  PENDIENTE
  EN_SEGUIMIENTO
  APROBADA
  RECHAZADA
  CONVERTIDA
}

model Client {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  email     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  quotes Quote[]

  @@map("clients")
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now()) @map("created_at")

  notes QuoteNote[]

  @@map("admin_users")
}

model Category {
  id   String @id @default(cuid())
  name String @unique

  materials Material[]

  @@map("categories")
}

model Material {
  id          String       @id @default(cuid())
  name        String
  description String?
  categoryId  String       @map("category_id")
  unit        MaterialUnit
  unitPrice   Decimal      @map("unit_price") @db.Decimal(10, 2)
  imageUrl    String?      @map("image_url")
  stock       Int?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  category Category    @relation(fields: [categoryId], references: [id])
  items    QuoteItem[]

  @@index([categoryId])
  @@index([active])
  @@map("materials")
}

model Quote {
  id        String      @id @default(cuid())
  folio     String      @unique
  clientId  String      @map("client_id")
  status    QuoteStatus @default(PENDIENTE)
  total     Decimal     @default(0) @db.Decimal(10, 2)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  client Client      @relation(fields: [clientId], references: [id])
  items  QuoteItem[]
  notes  QuoteNote[]

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@map("quotes")
}

model QuoteItem {
  id                String  @id @default(cuid())
  quoteId           String  @map("quote_id")
  materialId        String  @map("material_id")
  quantity          Decimal @db.Decimal(10, 3)
  unitPriceAtTime   Decimal @map("unit_price_at_time") @db.Decimal(10, 2)
  subtotal          Decimal @db.Decimal(10, 2)

  quote    Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@index([quoteId])
  @@index([materialId])
  @@map("quote_items")
}

model QuoteNote {
  id            String      @id @default(cuid())
  quoteId       String      @map("quote_id")
  authorId      String      @map("author_id")
  note          String
  statusAtNote  QuoteStatus @map("status_at_note")
  createdAt     DateTime    @default(now()) @map("created_at")

  quote  Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  author AdminUser @relation(fields: [authorId], references: [id])

  @@index([quoteId])
  @@map("quote_notes")
}

// Contador transaccional para folios consecutivos por año (COT-2026-000123)
model QuoteFolioCounter {
  year       Int @id
  lastNumber Int @default(0) @map("last_number")

  @@map("quote_folio_counters")
}
