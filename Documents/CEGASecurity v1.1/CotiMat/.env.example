# Variables leídas por docker-compose.yml para elegir los puertos publicados en el host.
# Los valores por defecto (5433/4010/5183/5184) se eligieron para no chocar con los
# puertos "de fábrica" (5432/4000/5173) que suelen ocupar otros proyectos en la misma
# máquina. Ajusta libremente si tienes conflictos con otros servicios locales.
DB_PORT=5433
API_PORT=4010
CLIENTE_PORT=5183
ADMIN_PORT=5184

# Secreto de firma de JWT para el panel admin — cámbialo en cualquier entorno real.
JWT_SECRET=change-this-in-production-please

# Credenciales del admin sembrado automáticamente al levantar el contenedor de la API.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
